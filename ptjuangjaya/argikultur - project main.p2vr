  <panorama>
    <id>master</id>
    <input>
      <patch/>
    </input>
    <viewingparameter>
      <pan/>
      <tilt/>
      <fov/>
      <flyinstart/>
    </viewingparameter>
    <userdata>
      <customprops/>
    </userdata>
    <projectsettings>
      <userdata>
        <customprops/>
      </userdata>
      <mapgrid>
        <anchor/>
      </mapgrid>
      <floorplangrid>
        <anchor/>
      </floorplangrid>
      <usenodealtitude>0</usenodealtitude>
      <language>id-ID</language>
      <translatehotspotmedia>1</translatehotspotmedia>
      <translatepinnedmedia>1</translatepinnedmedia>
      <translationspath>translations</translationspath>
      <fovmode>diagonal</fovmode>
      <translationsavailable>
        <value id="Project">id-ID</value>
        <value id="ar.po">ar</value>
        <value id="artmptmph.po">ar</value>
        <value id="en.po">en</value>
        <value id="nl.po">nl</value>
        <value id="zh_CN.po">zh-CN</value>
      </translationsavailable>
      <translationsnames>
        <value id="Project">Indonesia</value>
        <value id="ar.po">العربية</value>
        <value id="artmptmph.po">العربية</value>
        <value id="en.po">English</value>
        <value id="nl.po">Nederlands</value>
        <value id="zh_CN.po">简体中文</value>
      </translationsnames>
      <translationsenabled>
        <value id="Project">true</value>
        <value id="ar.po">true</value>
        <value id="artmptmph.po">true</value>
        <value id="en.po">true</value>
        <value id="nl.po">true</value>
        <value id="zh_CN.po">true</value>
      </translationsenabled>
    </projectsettings>
    <floorplans>
      <floorplan>
        <id>Map01</id>
        <mapprovider>openstreetmap</mapprovider>
        <mapstyle>streets</mapstyle>
        <type>web</type>
      </floorplan>
    </floorplans>
    <hotspots/>
    <output>
      <htmlcss>
        <html>
          <enabled>1</enabled>
          <filename>C:/xampp/htdocs/output/lampung/ptjuangjaya/index.html</filename>
          <values>
            <value id="cachebust">true</value>
            <value id="css"/>
            <value id="fitcover">false</value>
            <value id="htmltitle">$(upt)</value>
            <value id="jsxml">false</value>
            <value id="parseanchor">true</value>
          </values>
        </html>
        <facequality/>
        <transition>
          <zoomfov>40</zoomfov>
          <zoomafterinfov>140</zoomafterinfov>
          <zoomafteroutfov>40</zoomafteroutfov>
          <transitiontype>crossdissolve</transitiontype>
          <zoominenabled>0</zoominenabled>
          <transitiontime>0.5</transitiontime>
          <zoomspeed>1</zoomspeed>
        </transition>
        <autorotate/>
        <soundstransition/>
        <flyintransition/>
        <hotspottext/>
        <hotspotstyle>
          <viewmode>hidden</viewmode>
          <backgroundcolor>#0000ff,64</backgroundcolor>
          <bordercolor>#0000ff</bordercolor>
        </hotspotstyle>
        <webvr>
          <enabled>0</enabled>
          <toggleskinbutton>1</toggleskinbutton>
        </webvr>
        <tilesize>3000</tilesize>
        <filename>C:/xampp/htdocs/output/lampung/ptjuangjaya/pano.xml</filename>
        <leveltileformat>1</leveltileformat>
        <leveltilefilename>tiles/$y/cf_%c/l_%l/c_%x/tile_%y.webp</leveltilefilename>
        <cubefilename>images/$n_o.webp</cubefilename>
        <invertwheel>1</invertwheel>
        <dblclickfullscreen>1</dblclickfullscreen>
        <hideaboutbox>1</hideaboutbox>
        <skinfile>$d/lampung-skin.ggsk</skinfile>
        <vrskinfile>$d/lampung-skin.ggsk</vrskinfile>
        <quality>50</quality>
        <leveltilesize>512</leveltilesize>
        <projectionscontext>0</projectionscontext>
        <sensitivity>13</sensitivity>
        <windowwidth>1920</windowwidth>
        <windowheight>1020</windowheight>
      </htmlcss>
      <placeidcache>{"entries":[]}</placeidcache>
    </output>
    <streetview/>
    <streetviewproject/>
    <ggloudproject/>
    <sounds/>
    <animation>
      <title>Animation01</title>
    </animation>
    <customproperty>
      <variablename>hal</variablename>
      <type>text</type>
      <description>hal</description>
      <propertytype>hotspot</propertytype>
    </customproperty>
  </panorama>
</pano2vrconfig>
