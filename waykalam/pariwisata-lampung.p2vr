          <tiltsize>10</tiltsize>
          <fieldsize>90</fieldsize>
          <ambientlevel>0</ambientlevel>
          <startmutedmobile>0</startmutedmobile>
          <level>1</level>
          <loop>1</loop>
          <copyfile>1</copyfile>
          <clickmode>none</clickmode>
          <popoutscaling>100</popoutscaling>
          <popbackmode>stop</popbackmode>
          <hidepinned>0</hidepinned>
          <handcursor>0</handcursor>
          <webcontent>&lt;div id="Element02" style="width: 100%; height: 100%;">&lt;/div></webcontent>
          <permeable>1</permeable>
        </sound>
      </sounds>
      <id>node217</id>
    </panorama>
  </tour>
  <panorama>
    <id>master</id>
    <input>
      <patch/>
    </input>
    <viewingparameter>
      <pan/>
      <tilt/>
      <fov/>
      <flyinstart/>
    </viewingparameter>
    <userdata>
      <customprops/>
    </userdata>
    <projectsettings>
      <userdata>
        <customprops/>
      </userdata>
      <mapgrid>
        <anchor/>
      </mapgrid>
      <floorplangrid>
        <anchor/>
      </floorplangrid>
      <usenodealtitude>0</usenodealtitude>
      <language>id-ID</language>
      <translatehotspotmedia>1</translatehotspotmedia>
      <translatepinnedmedia>1</translatepinnedmedia>
      <translationspath>translations</translationspath>
      <fovmode>diagonal</fovmode>
      <translationsavailable>
        <value id="Project">id-ID</value>
        <value id="ar.po">ar</value>
        <value id="en.po">en</value>
        <value id="nl.po">nl</value>
        <value id="zh_CN.po">zh-CN</value>
      </translationsavailable>
      <translationsnames>
        <value id="Project">Indonesia</value>
        <value id="ar.po">العربية</value>
        <value id="en.po">English</value>
        <value id="nl.po">Nederlands</value>
        <value id="zh_CN.po">简体中文</value>
      </translationsnames>
      <translationsenabled>
        <value id="Project">true</value>
        <value id="ar.po">true</value>
        <value id="en.po">true</value>
        <value id="nl.po">true</value>
        <value id="zh_CN.po">true</value>
      </translationsenabled>
    </projectsettings>
    <floorplans>
      <floorplan>
        <id>MapsOpenStreet</id>
        <mapprovider>openstreetmap</mapprovider>
        <mapstyle>streets</mapstyle>
        <type>web</type>
      </floorplan>
    </floorplans>
    <hotspots/>
    <output>
      <placeidcache>{"entries":[]}</placeidcache>
      <htmlcss>
        <html>
          <enabled>1</enabled>
          <filename>D:/xampp/htdocs/lampung-output/waykalam/index.html</filename>
          <values>
            <value id="cachebust">false</value>
            <value id="css"/>
            <value id="fitcover">false</value>
            <value id="htmltitle">$(upt)</value>
            <value id="jsxml">false</value>
            <value id="parseanchor">true</value>
          </values>
        </html>
        <facequality/>
        <transition>
          <zoomfov>40</zoomfov>
          <zoomafterinfov>140</zoomafterinfov>
          <zoomafteroutfov>40</zoomafteroutfov>
          <transitiontype>crossdissolve</transitiontype>
          <zoominenabled>0</zoominenabled>
          <transitiontime>0.4</transitiontime>
          <zoomspeed>0.5</zoomspeed>
        </transition>
        <autorotate/>
        <soundstransition/>
        <flyintransition/>
        <hotspottext/>
        <hotspotstyle/>
        <webvr/>
        <tilesize>3600</tilesize>
        <filename>D:/xampp/htdocs/lampung-output/waykalam/pano.xml</filename>
        <skinfile>$d/lampung-skin.ggsk</skinfile>
        <hideaboutbox>1</hideaboutbox>
        <invertwheel>1</invertwheel>
        <dblclickfullscreen>1</dblclickfullscreen>
        <sensitivity>8</sensitivity>
        <leveltileformat>1</leveltileformat>
        <leveltilefilename>tiles/$y/cf_%c/l_%l/c_%x/tile_%y.webp</leveltilefilename>
        <cubefilename>images/$n_o.webp</cubefilename>
        <smoothhsmovement>1</smoothhsmovement>
        <projectionscontext>0</projectionscontext>
        <quality>50</quality>
        <leveltilesize>510</leveltilesize>
        <windowwidth>1920</windowwidth>
        <windowheight>1080</windowheight>
      </htmlcss>
    </output>
    <streetview/>
    <streetviewproject/>
    <ggloudproject/>
    <sounds/>
